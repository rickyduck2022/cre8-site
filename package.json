{
  "name": "craft",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @craft/api dev",
    "dev:purge": "node apps/api/scripts/purge.mjs",
    "dev:web": "node scripts/dev.mjs",
    "storybook": "pnpm --filter @craft/ui storybook",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
